<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="cs_canvas">#F7F8FA</color>
    <color name="ic_launcher_background">#0A1020</color>

    <style name="Theme.CyberShield" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/cs_canvas</item>
        <item name="colorPrimary">#2448F5</item>
        <item name="colorAccent">#2448F5</item>
    </style>

    <!-- Launch screen: plain canvas with the brand mark; the in-app intro continues from it. -->
    <style name="Theme.CyberShield.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cs_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.CyberShield</item>
    </style>
</resources>
