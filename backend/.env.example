# Copy to .env (never commit .env). Every key is optional: missing keys make that
# provider report "not_configured" and the Android app keeps working with local checks.

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Set to true only behind a reverse proxy you control (uses the first X-Forwarded-For address).
TRUST_PROXY=false
# Web demo origins allowed to call the API from a browser (CORS), comma-separated exact matches.
# Example: https://cybershield.vercel.app,http://localhost:5173. Empty: no CORS headers (the Android app does not need them).
ALLOWED_ORIGINS=

# --- Threat intelligence ---
# Google Safe Browsing v5 (non-commercial use only). https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal public API (4 req/min, 500/day, non-commercial). https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# abuse.ch URLhaus Auth-Key (free). https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# --- AI explanation ---
# Google AI Studio key for the Gemini API. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Training-data contributions (opt-in, redacted) ---
# Directory to append opt-in, already-redacted scam-message donations as daily JSONL. Empty disables
# the /v1/contribute endpoint (it then reports "not_configured"). The app redacts on-device first and
# the server rejects anything that still contains personal data. See docs/AI_ML_PLAN.md phase 2.
CONTRIBUTIONS_DIR=

# --- Limits (defaults shown) ---
RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=5
CONTRIBUTE_RATE_LIMIT_PER_MINUTE=10
VIRUSTOTAL_PER_MINUTE=4
CACHE_TTL_SECONDS=3600
MAX_BODY_BYTES=16384
PROVIDER_TIMEOUT_MS=5000
AI_TIMEOUT_MS=25000
