# Copy to .env (never commit .env). Every key is optional: missing keys make that
# provider report "not_configured" and the Android app keeps working with local checks.

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Set to true only behind a reverse proxy you control (uses the first X-Forwarded-For address).
TRUST_PROXY=false

# --- Threat intelligence ---
# Google Safe Browsing v5 (non-commercial use only). https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal public API (4 req/min, 500/day, non-commercial). https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# abuse.ch URLhaus Auth-Key (free). https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# --- AI explanation ---
# Google AI Studio key for the Gemini API. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Limits (defaults shown) ---
RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=5
VIRUSTOTAL_PER_MINUTE=4
CACHE_TTL_SECONDS=3600
MAX_BODY_BYTES=16384
PROVIDER_TIMEOUT_MS=5000
AI_TIMEOUT_MS=25000
